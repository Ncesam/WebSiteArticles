Environment variables:
  APP_DEBUG bool
    	Режим отладки
  APP_HOST string
    	Хост (default "localhost")
  APP_PORT int
    	Порт на котором запускается приложение (default "8080")
  AUTH_ACCESS_ALGO string
    	Алгоритм шифрования access-токена (default "HS256")
  AUTH_ACCESS_KEY string
    	Секрет для access-токенов
  AUTH_REFRESH_ALGO string
    	Алгоритм шифрования refresh-токена (default "HS256")
  AUTH_REFRESH_KEY string
    	Секрет для refresh-токенов
  POSTGRES_DATABASE string
    	Имя базы данных
  POSTGRES_HOST string
    	Хост базы (default "postgres")
  POSTGRES_PASSWORD string
    	Пароль от базы
  POSTGRES_PORT int
    	Порт базы данных (default "5432")
  POSTGRES_USER string
    	Пользователь базы
  VERSION string
    	Версия приложения (default "0.1")